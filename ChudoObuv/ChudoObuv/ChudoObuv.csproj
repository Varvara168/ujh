<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>Resources\app.ico</ApplicationIcon>
		<AssemblyTitle>Чудо Обувь</AssemblyTitle>
		<Product>Чудо Обувь</Product>
		<Company>Чудо Обувь</Company>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="MySqlConnector" Version="2.6.2" />
	</ItemGroup>


	<ItemGroup>
		<Resource Include="Resources\app.ico" />
		<Resource Include="Resources\logo.png" />
		<Content Include="Resources\picture.png" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Resources\Images\*.png" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
